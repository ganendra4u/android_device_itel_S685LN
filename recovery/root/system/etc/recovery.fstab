# recovery.fstab — itel S25 (S685LN) / UMS9230S
# Sourced from /vendor/etc/fstab.ums9230_S685LNV + live by-name symlinks
#
# Format: <src>  <mnt_point>  <type>  <mnt_flags>  <fs_mgr_flags>
#
# All by-name paths verified against /dev/block/by-name/ on live device:
#   boot_a/b         → sda36/37
#   init_boot_a/b    → sda40/41
#   vendor_boot_a/b  → sda38/39
#   dtbo_a/b         → sda44/45
#   super            → sda46
#   cache            → sda47
#   metadata         → sda51
#   userdata         → sda75
#   misc             → sda3
#   persist          → sda19
#   tranfs           → sda70
#   blackbox         → sda48
#   prodnv           → sda1
#   vbmeta_a/b       → sda49/50

# ── Dynamic (logical) partitions inside super ─────────────────────────────────
system      /system      erofs   ro  wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey,slotselect
system      /system      ext4    ro,barrier=1  wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey,slotselect
system_ext  /system_ext  erofs   ro  wait,avb=vbmeta_system,logical,first_stage_mount,slotselect
vendor      /vendor      erofs   ro  wait,avb=vbmeta_vendor,logical,first_stage_mount,slotselect
odm         /odm         erofs   ro  wait,avb=vbmeta_odm,logical,first_stage_mount,slotselect
product     /product     erofs   ro  wait,avb=vbmeta_product,logical,first_stage_mount,slotselect
vendor_dlkm /vendor_dlkm erofs   ro  wait,avb=vbmeta_system_ext,logical,first_stage_mount,slotselect
system_dlkm /system_dlkm erofs   ro  wait,avb=vbmeta_system_ext,logical,first_stage_mount,slotselect

# ── Physical partitions ───────────────────────────────────────────────────────
/dev/block/by-name/userdata   /data       f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier,atgc  latemount,wait,quota,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,formattable
/dev/block/by-name/metadata   /metadata   f2fs    nodev,noatime,nosuid  wait,formattable,first_stage_mount,check
/dev/block/by-name/metadata   /metadata   ext4    nodev,noatime,nosuid,errors=panic  wait,formattable,first_stage_mount,check
/dev/block/by-name/cache      /cache      f2fs    noatime,nosuid,nodev,discard  wait,check,formattable
/dev/block/by-name/cache      /cache      ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc  wait,check,formattable
/dev/block/by-name/tranfs     /tranfs     ext4    rw,noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc  wait,check,formattable,nofail,first_stage_mount
/dev/block/by-name/blackbox   /blackbox   f2fs    noatime,nosuid,nodev,discard  check
/dev/block/by-name/blackbox   /blackbox   ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc  check
/dev/block/by-name/prodnv     /mnt/vendor ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc  wait,check
/dev/block/by-name/misc       /misc       emmc    defaults  defaults
/dev/block/by-name/persist    /persist    ext4    noatime,nosuid,nodev  wait,check

# ── USB / SD card (vold managed) ──────────────────────────────────────────────
/devices/platform/soc/soc:ap-*/*.sdio/mmc_host/mmc1/mmc1:*/block/mmcblk1  auto  vfat  defaults  voldmanaged=sdcard0:auto,noemulatedsd,encryptable=footer
/devices/platform/soc/soc:*/*.usb/musb-hdrc.*.auto/usb*                    auto  vfat  defaults  voldmanaged=usbdisk:auto,encryptable=userdata
